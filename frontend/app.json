{
  "expo": {
    "name": "ParlourPilot",
    "slug": "parlourpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/parlourpilot-logo.png",
    "scheme": "parlourpilot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.saloninvoiceapp.djfiom",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload your salon logo to personalize your invoices"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/parlourpilot-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.saloninvoiceapp.djfiom",
      "permissions": [
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/parlourpilot-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/parlourpilot-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
