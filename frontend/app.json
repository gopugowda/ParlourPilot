{
  "expo": {
    "name": "ParlourPilot",
    "slug": "parlourpilot",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/parlourpilot-logo.png",
    "scheme": "parlourpilot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parlourpilot.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload your salon logo to personalize your invoices",
        "NSLocationWhenInUseUsageDescription": "Verify you're at the salon when punching attendance",
        "NSCameraUsageDescription": "Scan product barcodes to quickly add stock"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/parlourpilot-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.parlourpilot.app",
      "versionCode": 110,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DUMP",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/parlourpilot-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/parlourpilot-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ParlourPilot to access your photos so you can pick a salon logo.",
          "cameraPermission": "Scan product barcodes and product labels to add stock",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan product barcodes to quickly add stock",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "deploymentTarget": "15.5",
            "privacyManifestAggregationEnabled": true,
            "privacyManifests": {
              "NSPrivacyAccessedAPITypes": [
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
                  "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
                  "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
                  "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
                }
              ]
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Verify you're at the salon when punching attendance"
        }
      ],
      [
        "./plugins/with-image-crop-picker.js",
        {
          "photoText": "Attach photos to stock items and expense receipts",
          "cameraText": "Scan product labels to auto-fill stock"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
